<Window x:Class="MultiClip.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiClip"
        Width="420"
        SizeToContent="Height"
        MaxHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Animation d'apparition -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.15"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="12"
            Padding="8">
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- En-tête -->
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="MultiClip" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountLabel" FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✗" Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource SubtextBrush}"
                        FontSize="14" Cursor="Hand" Padding="4,0"/>
            </Grid>

            <!-- Barre de recherche -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="4,0,4,6">
                <Grid>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource SubtextBrush}"/>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             FontSize="13" Padding="32,8,8,8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="Rechercher dans l'historique..."
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="32,0,0,0"
                               Foreground="{StaticResource SubtextBrush}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Liste des entrées -->
            <ListBox x:Name="ClipList"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MaxHeight="360"
                     MouseDoubleClick="ClipList_MouseDoubleClick"
                     KeyDown="ClipList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Preview}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding TimeAgo}"
                                       Foreground="{StaticResource SubtextBrush}"
                                       FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pied de page -->
            <TextBlock Text="↵ Coller  •  Echap Fermer  •  ↑↓ Naviguer"
                       Foreground="{StaticResource SubtextBrush}"
                       FontSize="10" HorizontalAlignment="Center"
                       Margin="0,6,0,4"/>
        </StackPanel>
    </Border>
</Window>